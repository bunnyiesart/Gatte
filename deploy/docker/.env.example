# Copy to .env and set GATTE_DOMAIN. Nothing else is required.

# The name analysts reach Gatte on. The identity provider is served on
# auth.<this name>, so DNS must point both names at this host.
# For a quick local try: gatte.localtest.me (it and every subdomain resolve
# to 127.0.0.1).
GATTE_DOMAIN=gatte.example.org

# internal: this container makes a private CA (analysts install it once; the
#           connect script does it for them).
# acme:     a public certificate from Let's Encrypt; needs both names
#           reachable from the internet on 443 and 80, and GATTE_ACME_EMAIL.
GATTE_TLS=internal
# GATTE_ACME_EMAIL=soc@example.org

# The HTTPS port, published on the host and used in every URL when it is
# not 443. Use e.g. 8443 where 443 is taken or needs privileges.
GATTE_PORT=443

# Host port for plain HTTP (only Let's Encrypt's challenge uses it).
GATTE_HTTP_PORT=80

TZ=America/Sao_Paulo

# The image release to run (ghcr.io/bunnyiesart/gatte). Pin one in
# production; "latest" moves with every release.
# GATTE_VERSION=0.1.0

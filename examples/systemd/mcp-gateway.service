# The gateway itself, `mcp-gateway serve`, as the service account.
#
# systemctl reload mcp-gateway   applies [[role]], [group_to_role] and
#                                [quota] from config.toml without a restart
#                                (design/adr/0044). It runs `mcp-gateway
#                                reload`, which waits for serve's answer, so
#                                a file serve refuses makes the reload FAIL
#                                and the old policy stays in force. Every
#                                other key needs `systemctl restart`.
# The row it writes names the service account ([cli env]); for your own
# name, run `sudo -u mcpgw mcp-gateway reload -config ...` instead.
[Unit]
Description=Gatte MCP gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mcpgw
Group=mcpgw
ExecStart=/usr/local/bin/mcp-gateway serve -config /etc/mcp-gateway/config.toml
ExecReload=/usr/local/bin/mcp-gateway reload -config /etc/mcp-gateway/config.toml -wait 2m
# serve shuts down in at most 15 s and then reaps its backends; give it
# that before SIGKILL, which would orphan them.
TimeoutStopSec=30s
Restart=on-failure
RestartSec=5s
# sops must be on PATH (the vault is decrypted by the sops CLI).
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# The database directory and the [audit.siem] file's directory, as in
# config.example.toml; adjust to yours.
ReadWritePaths=/var/db/mcp-gateway /var/log/mcp-gateway
ProtectSystem=strict
PrivateTmp=yes
# NoNewPrivileges= is deliberately not set: rootless podman (-transport
# oci) needs the setuid newuidmap/newgidmap helpers.

# Environment for gatte-anchor-check.sh and the gatte-anchor-verify.sh it runs.
# Copy to /usr/local/etc/gatte/anchor.env on the operator box, fill in the
# credentials, and lock it down:
#
#   install -d -m 0750 /usr/local/etc/gatte
#   install -m 0600 deploy/gatte-anchor-check.env.example /usr/local/etc/gatte/anchor.env
#   $EDITOR /usr/local/etc/gatte/anchor.env
#
# Plain KEY=value, no `export`, no quotes needed unless a value has spaces: the
# wrapper sources it with `set -a` so the values reach the verify child, and a
# systemd EnvironmentFile reads the same format. Keep it out of the crontab and
# out of version control -- this file is only the example.

# Graylog credentials. Required. The verify script refuses to run without them.
GRAYLOG_USER=
GRAYLOG_PASS=

# Overrides for a deployment that does not match gatte-anchor-verify.sh's
# defaults. Uncomment only what differs.
#CHAIN=gatte-jail-01
#GW_HOST=root@198.18.0.4
#GW_JAIL=mcp-gateway-test
#GW_USER=mcpgw
#GRAYLOG=http://localhost:9100/api
#GW_CONFIG=/usr/local/etc/mcp-gateway/config.toml
# RANGE must span the whole trail for the lag-vs-tamper call to be drawn.
#RANGE=86400

# Wrapper tuning. Defaults shown.
#ANCHOR_FAIL_THRESHOLD=2
#ANCHOR_SYSLOG_TAG=gatte-anchor
#STATE_DIR=/var/db/gatte-anchor

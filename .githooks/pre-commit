#!/usr/bin/env python3
"""
Hook pre-commit: barra segredo e termo sensivel antes do commit.

Instalacao, uma vez por clone:

    git config core.hooksPath .githooks

Este hook e consultivo, nao e controle. Ele roda na sua maquina e
'git commit --no-verify' passa por cima dele. O controle de verdade
e a varredura do lado do servidor.

Duas checagens:

1. Segredo. Sempre ativa. Mesmos padroes do 'harden.py --scan-secrets'.
2. Termo sensivel. Opcional. So roda se existir a lista local de termos.

A lista de termos NAO fica no repositorio, de proposito: guardar nome de
cliente aqui seria commitar justamente o que se quer evitar. Ela mora fora
do projeto, uma por maquina:

    ~/.config/bunnyiesart/slugs      vale para todos os repositorios
    .slugs                        na raiz do repositorio, so para ele

O '.slugs' e ignorado pelo git, entao pode conter termo real.

Formato dos dois, um por linha, 'termo=slug':

    Nome Do Cliente=cliente-a
    Outro Cliente SA=cliente-b

Linha iniciada por # e comentario. Os dois arquivos somam.
Para usar outro caminho no global:

    git config hooks.slugsPath /caminho/da/lista
"""
import os
import re
import subprocess
import sys

# ------------------------------------------------------------------ segredos
PADROES = [
    ("chave privada",       re.compile(r"-----BEGIN (?:RSA |DSA |EC |OPENSSH |PGP )?PRIVATE KEY-----")),
    ("AWS access key",      re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("AWS secret key",      re.compile(r"(?i)aws_secret_access_key\s*[:=]\s*\S{40}")),
    ("token GitHub/Gitea",  re.compile(r"\bgh[pousr]_[A-Za-z0-9]{30,}\b")),
    ("token Slack",         re.compile(r"\bxox[baprs]-[0-9A-Za-z-]{10,}")),
    ("webhook Discord",     re.compile(r"discord(?:app)?\.com/api/webhooks/\d+")),
    ("JWT",                 re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]+")),
    ("URL com credencial",  re.compile(r"(?i)\b(?:postgres|postgresql|mysql|mongodb|redis|amqp|ftp)(?:\+\w+)?://[^:/\s]+:[^@\s]{3,}@")),
    ("senha em atribuicao", re.compile(r"""(?i)\b(?:password|passwd|senha|api_key|apikey|secret|token)\s*[:=]\s*["']([^"'\s]{8,})["']""")),
    ("senha Ansible",       re.compile(r"(?i)\bansible_(?:ssh_)?pass(?:word)?\s*[:=]\s*\S{4,}")),
]

ISCA_FALSA = re.compile(
    r"(?i)(example|exemplo|changeme|troque|your[_-]|dummy|placeholder|redacted|"
    r"xxxx|<[^>]+>|\{\{|\$\{|fake|sample|test123|senha123)")

EXT_TEXTO = {".py", ".sh", ".bash", ".zsh", ".yml", ".yaml", ".json", ".toml", ".ini",
             ".cfg", ".conf", ".env", ".txt", ".md", ".tf", ".tfvars", ".j2", ".xml",
             ".properties", ".sql", ".rb", ".js", ".ts", ".go", ".php", ".pl", ".ps1",
             ".csv", ".tsv", ".log", ".service", ".tmpl", ""}


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True).stdout


ARQ_REPO = ".slugs"


def caminho_global():
    cfg = git("config", "--get", "hooks.slugsPath").strip()
    if cfg:
        return os.path.expanduser(cfg)
    base = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
    return os.path.join(base, "bunnyiesart", "slugs")


def caminho_repo():
    raiz = git("rev-parse", "--show-toplevel").strip()
    return os.path.join(raiz, ARQ_REPO) if raiz else ARQ_REPO


def carregar_termos():
    """Le a lista global e a do repositorio. Nenhuma das duas significa checagem desligada."""
    termos = []
    for p in (caminho_global(), caminho_repo()):
        if not os.path.exists(p):
            continue
        for linha in open(p, encoding="utf-8"):
            linha = linha.strip()
            if not linha or linha.startswith("#") or "=" not in linha:
                continue
            termo, slug = linha.split("=", 1)
            termo, slug = termo.strip(), slug.strip()
            if termo:
                termos.append((termo, slug, re.compile(re.escape(termo), re.I)))
    return termos


def linhas_adicionadas(arq):
    """So o que este commit acrescenta. Segredo que ja estava no arquivo
    e problema da varredura do servidor, nao de quem mexeu em outra linha."""
    diff = git("diff", "--cached", "-U0", "--", arq)
    saida, n = [], 0
    for linha in diff.splitlines():
        if linha.startswith("@@"):
            m = re.search(r"\+(\d+)", linha)
            n = int(m.group(1)) if m else 0
        elif linha.startswith("+") and not linha.startswith("+++"):
            saida.append((n, linha[1:]))
            n += 1
    return saida


def mascarar(linha, m):
    """Nunca imprime o segredo inteiro."""
    achado = m.group(0)
    visivel = achado[:4] if len(achado) > 12 else ""
    return linha.replace(achado, f"{visivel}<{len(achado)} chars mascarados>").strip()[:100]


def main():
    arquivos = [a for a in git("diff", "--cached", "--name-only",
                               "--diff-filter=ACM").splitlines() if a]
    termos = carregar_termos()
    segredos, sensiveis = [], []

    for arq in arquivos:
        if os.path.splitext(arq)[1].lower() not in EXT_TEXTO:
            continue
        for n, linha in linhas_adicionadas(arq):
            if len(linha) > 1000:
                continue
            for rotulo, rx in PADROES:
                m = rx.search(linha)
                if not m:
                    continue
                # O filtro de exemplo vale para o VALOR achado, nao para a linha.
                # Senao um "# example" no fim da linha liberaria segredo real.
                if ISCA_FALSA.search(m.group(0)):
                    continue
                if "BEGIN" in linha and "PRIVATE KEY" in linha:
                    continue
                segredos.append((rotulo, arq, n, mascarar(linha, m)))
                break
            for termo, slug, rx in termos:
                if rx.search(linha):
                    sensiveis.append((termo, slug, arq, n))

    if not segredos and not sensiveis:
        return 0

    print()
    if segredos:
        print("COMMIT BARRADO: possivel segredo no conteudo em stage")
        for rotulo, arq, n, ctx in segredos:
            print(f"  {rotulo:20} {arq}:{n}")
            print(f"  {'':20} {ctx}")
        print()
        print("  Se ja foi commitado antes, remover o arquivo nao resolve.")
        print("  O historico guarda o valor. Rotacione a credencial.")
    if sensiveis:
        if segredos:
            print()
        print("COMMIT BARRADO: termo sensivel no conteudo em stage")
        for termo, slug, arq, n in sensiveis:
            alvo = slug or "um slug generico"
            print(f"  {arq}:{n}  troque \"{termo}\" por \"{alvo}\"")
        print()
        print(f"  Listas: {caminho_global()} e {ARQ_REPO} na raiz")
    print()
    print("  Falso positivo? Ajuste a linha, ou pule com:")
    print("      git commit --no-verify")
    print()
    return 1


if __name__ == "__main__":
    sys.exit(main())

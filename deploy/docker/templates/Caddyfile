# Generated by gatte-entrypoint on every start (design/adr/0049). Caddy
# runs in the gateway's own container, so 127.0.0.1:8080 is Gatte's own
# loopback listener (design/adr/0011) and 127.0.0.1:9091 is Authelia's.
{
	admin off
@GLOBAL@
}

# The gateway. Host is rewritten to the loopback address because the MCP
# SDK's DNS-rebinding protection refuses any other Host (the same rewrite
# deploy/gateway-jail/nginx.conf makes); X-Forwarded-For carries the
# analyst's address into the audit trail.
@GW_SITE@ {
@TLS@
	handle /ca.crt {
		root * /gatte/edge/public
		file_server
	}
	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:8080 {
			header_up Host 127.0.0.1:8080
			header_up X-Forwarded-Host {host}
			flush_interval -1
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}
}

# The identity provider analysts sign in at.
@IDP_SITE@ {
@TLS@
	reverse_proxy 127.0.0.1:9091
}
